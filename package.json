{
  "name": "three-vite-demo",
  "version": "1.0.0",
  "description": "原生 JS + Three.js + Vite 项目",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-enemy-thumbnails.mjs && node scripts/open-firewall.mjs",
    "dev": "vite",
    "firewall:setup": "scripts\\firewall-setup.bat",
    "build": "vite build",
    "prebuild": "node scripts/generate-enemy-thumbnails.mjs",
    "enemies:thumbnails": "node scripts/generate-enemy-thumbnails.mjs",
    "lint": "eslint . --max-warnings=0",
    "check:turns": "node scripts/stamina-deck-check.mjs && node scripts/stamina-ui-check.mjs",
    "check:combat-motion": "node scripts/combat-motion-check.mjs && node scripts/enemy-camera-animation-check.mjs",
    "check:board-pointer": "node scripts/board-pointer-check.mjs",
    "check:arttweak": "node scripts/art-tweak-check.mjs",
    "check:traps": "node scripts/traps-check.mjs",
    "check:items": "node scripts/items-check.mjs && node scripts/pickup-ambush-check.mjs",
    "check:basics": "node scripts/basic-rules-check.mjs",
    "check:statuses": "node scripts/statuses-check.mjs",
    "check:redesign": "node scripts/item-redesign-check.mjs",
    "check:weapons": "node scripts/weapon-rules-check.mjs",
    "check:expansion": "node scripts/expansion-check.mjs",
    "check:totems": "node scripts/totems-check.mjs && node scripts/battle-content-check.mjs",
    "check:pets": "node scripts/pets-ball-check.mjs && node scripts/stamina-ui-check.mjs",
    "check:weapon-tiers": "node scripts/weapon-progression-check.mjs",
    "check:playtest-balance": "node scripts/playtest-balance-check.mjs",
    "check:attributes": "node scripts/attribute-items-check.mjs",
    "check:enemies": "node scripts/enemies-check.mjs && node scripts/enemy-speed-check.mjs",
    "check:animation": "node scripts/shadow-editor-cache-check.mjs && node scripts/enemy-completion-check.mjs && node scripts/enemy-grounding-check.mjs",
    "check:enemy-preview": "node scripts/enemy-preview-check.mjs",
    "preview": "vite preview",
    "sprites:variants": "python scripts/generate-sprite-resolutions.py",
    "enemies:texture-styles": "python scripts/generate-enemy-texture-styles.py",
    "check:enemy-texture-styles": "python scripts/enemy-texture-styles-check.py && node scripts/enemy-preview-check.mjs",
    "check:rules": "node scripts/v2-check.mjs",
    "check:dungeon": "node scripts/dungeon-check.mjs",
    "check:synergies": "node scripts/synergies-check.mjs",
    "check:progression": "node scripts/progression-check.mjs && node scripts/progression-ui-check.mjs",
    "check:wiki": "node scripts/wiki-check.mjs && node scripts/wiki-items-ui-check.mjs",
    "check:card-relief": "python scripts/generate-card-back-normals.py --check && node scripts/board-textures-check.mjs && node scripts/card-body-check.mjs && node scripts/card-relief-check.mjs",
    "check:stamina": "node scripts/stamina-deck-check.mjs && node scripts/stamina-ui-check.mjs && node scripts/stamina-flame-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "marked": "^18.0.14",
    "three": "^0.185.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "vite": "^8.2.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
